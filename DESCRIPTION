Package: LFJM
Type: Package
Title: Longitudinal Functional Joint Models
Version: 1.0.0
Authors@R: person(
    "Ufuk", "Beyaztas",
    email = "ufukbeyaztas@gmail.com",
    role = c("aut", "cre", "cph"),
    comment = c(ORCID = "0000-0002-5208-4950")
